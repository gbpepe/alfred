# Multi-branch On-Demand Staging unit template (alfred-test@<slug>.service).
# Controlled dynamically by `deploy/spinup-test.sh`, `deploy/reload-test.sh`, and `deploy/teardown-test.sh`.
[Unit]
Description=Alfred Multi-Agent Core (Test / Staging %i — On-Demand)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alfred
Group=alfred
WorkingDirectory=/opt/alfred-worktrees/alfred-test-%i
EnvironmentFile=/opt/alfred-worktrees/alfred-test-%i/.env
EnvironmentFile=-/opt/alfred-worktrees/alfred-test-%i/.env.ports
Environment=NODE_ENV=production
Environment=ALFRED_ENV=test
Environment=ALFRED_DB_PATH=store/alfred-test.db
Environment=ALFRED_WORKSPACES_DIR=workspaces-test
Environment=ALFRED_BUDGET_MULTIPLIER=0.2
Environment=ALFRED_SIM_ONLY=true
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=PATH=/home/alfred/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NPM_CONFIG_PREFIX=/home/alfred/.local
ExecStart=/usr/bin/node /opt/alfred-worktrees/alfred-test-%i/dist/alfred/run.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=1G
CPUQuota=50%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/alfred-worktrees/alfred-test-%i -/home/alfred/.local -/home/alfred/.claude -/home/alfred/.codex -/home/alfred/.gemini -/home/alfred/.config -/home/alfred/.cli-profiles -/etc/alfred
SyslogIdentifier=alfred-test-%i

[Install]
WantedBy=multi-user.target
