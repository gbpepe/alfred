[Unit]
Description=Alfred Test Web Dashboard (WEB_ONLY — Isolated Staging UI + Simulated Discord)
After=network-online.target alfred-test.service
Wants=network-online.target

[Service]
Type=simple
User=alfred
Group=alfred
WorkingDirectory=/opt/alfred-worktrees/alfred-test
EnvironmentFile=/opt/alfred-worktrees/alfred-test/.env
Environment=NODE_ENV=production
Environment=WEB_ONLY=true
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=3422
Environment=ALFRED_WEB_PORT=3422
Environment=ALFRED_ENV=test
Environment=ALFRED_WEB_DB_PATH=/opt/alfred-worktrees/alfred-test/store/alfred-test.db
Environment=ALFRED_SIM_PORT=3421
Environment=ALFRED_AGENTS_CONFIG=/opt/alfred-worktrees/alfred-test/config/agents.json
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node /opt/alfred-worktrees/alfred-test/dist/web-only.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alfred-worktrees/alfred-test
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
