[Unit]
Description=Alfred Test Web Dashboard (%i — Isolated Staging UI + Simulated Discord)
After=network-online.target alfred-test@%i.service
Wants=network-online.target

[Service]
Type=simple
User=alfred
Group=alfred
WorkingDirectory=/opt/alfred-worktrees/alfred-test-%i
EnvironmentFile=/opt/alfred-worktrees/alfred-test-%i/.env
EnvironmentFile=-/opt/alfred-worktrees/alfred-test-%i/.env.ports
Environment=NODE_ENV=production
Environment=WEB_ONLY=true
Environment=WEB_HOST=127.0.0.1
Environment=ALFRED_ENV=test
Environment=ALFRED_WEB_DB_PATH=/opt/alfred-worktrees/alfred-test-%i/store/alfred-test.db
Environment=ALFRED_AGENTS_CONFIG=/opt/alfred-worktrees/alfred-test-%i/config/agents.json
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=PATH=/home/alfred/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NPM_CONFIG_PREFIX=/home/alfred/.local
ExecStart=/usr/bin/node /opt/alfred-worktrees/alfred-test-%i/dist/web-only.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/alfred-worktrees/alfred-test-%i -/home/alfred/.local -/home/alfred/.claude -/home/alfred/.codex -/home/alfred/.gemini -/home/alfred/.config -/etc/alfred
MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=1G
SyslogIdentifier=alfred-test-web-%i

[Install]
WantedBy=multi-user.target
