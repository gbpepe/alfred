# Alfred konfiguráció
# Elsődleges csatorna: kizárólag Discord támogatott (CHANNEL_PROVIDER=discord) + Email értesítések/jóváhagyások.
CHANNEL_PROVIDER=discord
# CHANNEL_CHAT_ID=your_discord_channel_or_dm_id
OWNER_NAME=Your Name
HEARTBEAT_CALENDAR_ID=your_calendar_id_or_email

# Branding (optional). The installer writes these for you; defaults below keep
# the product named "Alfred". They are INDEPENDENT:
#   BOT_NAME    -- the main agent's display name (e.g. "MyAssistant")
#   BRAND_NAME  -- the product / system name shown in the dashboard chrome
#                  (browser tab, sidebar, topbar). Defaults to BOT_NAME.
# Set BRAND_NAME only if you want the product called something different from
# the agent. Example: BOT_NAME="MyAssistant", BRAND_NAME="AcmeAI".
# BOT_NAME=Alfred
# BRAND_NAME=AcmeAI
# MAIN_AGENT_ID and SERVICE_ID are derived by the installer (ASCII slugs of
# BOT_NAME / BRAND_NAME) and rarely need manual editing. MAIN_AGENT_ID is the
# internal agent id (tmux session, DB, API routing); SERVICE_ID names the OS
# service units (launchd com.<id>.* / systemd <id>-*) and defaults to
# MAIN_AGENT_ID.
# MAIN_AGENT_ID=alfred
# SERVICE_ID=alfred
#
# SCHEDULED_DELIVERY_CHANNEL -- where the MAIN agent's scheduled-task results
# go, as "discord:<channel id>". Unset = the main agent's own bound Discord
# channel, as before. Sub-agent tasks are never affected; a task that pins its
# own chat (task-config.json channelChatId) or says "none" keeps it. Also
# settable on the dashboard Settings page; read fresh on every fire, no restart.
# SCHEDULED_DELIVERY_CHANNEL=discord:123456789012345678
#
# FLEET_LEAD_ID is WHO TO NOTIFY when a harness gate flags something (the
# provenance gate's "tell the fleet lead" step). It is NOT this install's own
# agent id: on an install that is its own lead leave it unset and it falls back
# to MAIN_AGENT_ID. Set it only when the lead is a different agent (e.g. this
# install's own agent is "alfred" but the fleet lead runs elsewhere). Do NOT
# point MAIN_AGENT_ID at a remote lead for this -- the channel coordinator would
# look for a "<lead>-channels" tmux session that does not exist on this host.
# FLEET_LEAD_ID=
#
# VOICE_CHANNEL_ID: a külső hang-relé ezen a feladói azonosítón küldi a gazda
# diktált üzeneteit. Alapértéke "hanna"; csak akkor állítsd, ha a reléd más néven
# ír. Érvénytelen érték, vagy ha egyezik a fő ágens, egy al-ágens, a gazda vagy
# egy SYSTEM_SENDER_IDS-beli feladó nevével: "hanna" marad, figyelmeztetéssel a
# dashboard naplójában. Ha maga a "hanna" is ütközik, a hangcsatorna kikapcsol
# (hibával a naplóban). Az azonosító foglalt: ágens nem kaphatja meg. Indításkor
# olvasódik, a módosításhoz újraindítás kell.
# VOICE_CHANNEL_ID=hanna

# Claude hitelesítés. A rendszer ÖT helyen keresi, ebben a sorrendben, és az
# ELSŐ találat elég -- ezért ezek a kulcsok itt szándékosan ki vannak
# kommentelve (ld. claudeAuthPresent() a src/web/routes/onboarding.ts-ben):
#   1. CLAUDE_CODE_OAUTH_TOKEN (.env)  -- hosszú életű setup-token (~1 év)
#   2. ANTHROPIC_API_KEY (.env)        -- API-kulcsos üzemmód
#   3. ~/.claude/.credentials.json     -- interaktív login (Linux)
#   4. store/.claude-oauth-token       -- flotta setup-token (onboarding wizard)
#   5. macOS Keychain                  -- interaktív login (macOS alapértelmezés)
# macOS-en tehát egy sima `claude` login után NEM kell ide semmit írni.
# Fej nélküli (headless) futáshoz -- ütemezett flotta-ágensek saját
# CLAUDE_CONFIG_DIR-rel -- kell a setup-token: `claude setup-token`, majd:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-...

# Opcionális:
# KANBAN_SWIMLANE_DEFAULT_GROUP=assignee   # none (alapért.) | assignee | priority
# KANBAN_SWIMLANE_SEPARATOR_COLOR=#3d3d3a  # swimlane-ok közti szaggatott elválasztó színe
# KANBAN_LABEL_COLORS=#3b82f6,#0ea5e9,#10b981,#14b8a6,#8b5cf6,#64748b  # kártya-címkék választható színpalettája
# WEB_PORT=3420
# Az új ügynökök alapértelmezett modellje + a háttér-worker sessionök modellje.
# Meglévő ügynökök NEM változnak tőle (az agent-config.json-jukban lévő konkrét
# modell marad). Újraindítás után lép életbe. Alapérték: claude-opus-5[1m]
# DEFAULT_AGENT_MODEL=claude-opus-5
# WEB_HOST=127.0.0.1       # FONTOS: 0.0.0.0-val a dashboard elérhető a hálózatról. Használj DASHBOARD_TOKEN-t!
# OLLAMA_URL=http://localhost:11434
# MEMORY_CONTENT_FILTER_STRICT_COMMANDS=1  # memória-szűrő: a parancs-szintaxis mintákat is elutasítja (alapért. ki)
# OSS_INVENTORY_NOTES_DIRS=research  # nyílt forrású leltár: ezekből az ügynök-mappákból olvassa a kutatási jegyzeteket (vesszővel elválasztva)
# OSS_INVENTORY_OWN_OWNERS=  # nyílt forrású leltár, vesszővel elválasztott tulajdonosnevek: a bejárás által elért, olvasható http(s)- vagy ssh-originű klónok a listán vannak, hacsak az origin-tulajdonosnevük (a klón saját origin-címének első útvonal-tagja, bármelyik hoszton) nem szerepel itt; ezeket megszámolja, nem listázza. A tulajdonjogot nem a telepítés remote-jaiból következteti ki. A bejárás határai: docs/config-reference.md
# MEMORY_IMPORT_CATEGORIZE_MODEL=gemma3:4b  # memória-import besoroló FELÜLBÍRÁLÁSA; üres = telepített gemma4 felismerése, olyan híján minden warm
# ALFRED_ENV=linux-server  # legacy OS platform override (macos | linux-server | linux-gui); Alfred Core környezeti módhoz ld. lent: ALFRED_ENV=production|test|ops
# GOOGLE_API_KEY=your_google_api_key

# Opt-in automatikus frissítés. Alapértelmezetten KI. Ha 1-re állítod, a seedelt
# "auto-update" ütemezett feladat minden szerdán 04:00-kor lefuttatja a robusztus
# update.sh-t (pull + build + restart + health-check + szükség esetén rollback),
# és a kimenetről csatorna-riasztást küld. Bármi más érték = kikapcsolva.
# AUTO_UPDATE_ENABLED=0

# Persona-őr értesítő. Alapértelmezetten KI. A scripts/hooks/persona-change-notify.py
# a FŐÁGENS minden eszközhívása után (csak a fő .claude/settings.json köti be, így egy
# al-ágens saját CLAUDE.md-írása a főágens következő eszközhívásakor látszik) összeveti a CLAUDE.md / SOUL.md fájlok (a főágensé és az
# agents/*/ alattiak) lenyomatát. KI állapotban csak naplóz (store/persona-changes.log),
# 1-re állítva a gazdának is szól a csatornán, ha egy fájl módosult, új lett vagy
# eltűnt. Értékek: 1 / true / yes / on = BE, bármi más = KI.
# PERSONA_GUARD_NOTIFY=0
# Föderáció (több Alfred-példány összekötése):
# A föderációnak NINCS .env kulcsa -- a konfiguráció a store/federation.json
# fájlban él (enabled, systemId, peers[] társankénti inbound/outbound
# tokenekkel). Kezelés: a dashboard Föderáció menüpontja (curl-fallback:
# PUT /api/federation/peers; dashboard-token, de ha már van dashboard-login, a
# gazda sessionje kell). Alapból kikapcsolva,
# fail-closed. Részletek: docs/federation.md

# Model for the MAIN agent's channel session. Optional: when unset, the launcher
# falls back to `.model` in .claude/settings.json. Set it here rather than in
# settings.json -- that file is tracked, so a local edit blocks the update
# preflight and is reverted by the next update.
# MAIN_AGENT_MODEL=claude-opus-5

# Külső (nem flotta-) rendszerek, amelyek feladóként megjelenhetnek a
# POST /api/messages hívásban. Alapból ÜRES: friss telepítés változatlanul
# viselkedik. A from-auth kapu regisztrált flotta-ügynököt (agents/<id>/) és a
# tulajdonost engedi; egy szomszédos RENDSZER (ügykezelő, jegyrendszer), amely
# csak értesíti az ügynököt, nem rendelkezik ilyen könyvtárral, ezért elutasítva
# kapna 403-at. Vesszővel elválasztva, a dashboard újraindítása után lép életbe.
# Ne flotta-ügynököt írj ide -- azok a saját könyvtáruk alapján úgyis átmennek.
# A telepítő ide felveszi a flotta két saját őrét (prod-tree-guard,
# channels-sh-guard), hogy a riasztásuk a saját nevükön menjen, ne a fő ügynökén;
# a már itt álló bejegyzéseidet megtartja, és mögéjük fűzi őket. Ha valamelyiket
# kiveszed, a telepítő következő futása újra felveszi (rendszer-azonosítók).
# SYSTEM_SENDER_IDS=cortex

# Sürgős buszüzenet HTTP-n: azoknak a beléptetett eszközkulcsoknak a numerikus
# azonosítója (a GET /api/auth/device-keys listázza), amelyek a POST /api/messages
# hívásban "urgent": true-t küldhetnek. A sürgős sort a router a FOGLALT
# munkamenetbe is beírja, ezért alapból ÜRES: HTTP-n senki nem küldhet sürgőset
# (a dashboardon belüli írók nem érintettek). Egy eszközkulcs önmagában nem elég,
# mert a közös dashboard-tokennel kulcs verhető; és szándékosan nincs a beállítások
# között. Ugyanez a kulcs küldhet [STOP]-ot is: from = a fő ágens, a szöveg
# "[STOP]"-pal kezdődik, és "urgent": true. Vesszővel elválasztva, a dashboard
# újraindítása után lép életbe.
# MESSAGE_URGENT_DEVICE_IDS=7

# A kimenő support-levelek alapértelmezett CC-címe (jellemzően a tulajdonos saját
# postafiókja, hogy lássa, mi ment ki a nevében). Üresen hagyva vagy kihagyva NINCS
# automatikus CC, tehát egy friss telepítés viselkedése változatlan. Egy adott
# küldésnél a --no-owner-cc kapcsoló mond le róla kimondottan; egy kimondott --cc
# értéket az nem ejt ki. Csak ebből a fájlból olvasódik, környezeti változóból
# nem: egy `SUPPORT_OWNER_CC=... python3 ...` előtag így nem tud címzettet adni.
# SUPPORT_OWNER_CC=owner@example.com
# A fo agens kimeno levelkapuja (scripts/hooks/email-approval-gate.py): ha be van
# allitva, minden send_email / Gmail-kuldes es piszkozat-letrehozas csak akkor megy
# at, ha ez a cim ott van a to, cc vagy bcc mezoben, MINDEN email_send szinten.
# Ures vagy hianyzo: az ellenorzes ki van kapcsolva. Csak ebbol a fajlbol olvasodik,
# kornyezeti valtozobol nem (egy ures ertek a kornyezetben igy nem kapcsolhatja ki).
# MAIL_OWNER_CC=owner@example.com
# A címzett-ledger (store/verified-recipients.json) a fő ágensre is: 1 esetén a
# fő ágens jóváhagyás-kapuja és a projekt saját küldői (support-mail, graph-mail)
# minden címzettet a ledgerhez mérnek, piszkozatnál is. Alapból ki: a sub-ügynökökre
# a ledger mindig él, a fő ágensre a telepítés gazdája dönt. Csak ebből a fájlból.
# MAIN_AGENT_RECIPIENT_LEDGER=1
# Mely al-ügynökről vegye le a flotta deny-floorja a sudo-tiltást (Bash(sudo:*),
# Bash(*/sudo *)). Ágens-nevek vesszővel vagy szóközzel; alapból üres = senkiről.
# Csak ebből a fájlból olvasódik, a dashboard beállítás-oldala NEM írja (a közös
# tokennel bármely al-ügynök írhatná), és az ágens saját agent-config.json-ja sem
# számít. A fő ügynökre nem hat. Az érvényesülés a következő respawnnal jön.
# Ez csak a deny-listát lazítja: ahol a profil bekapcsolja a destructive-gate hookot
# (scripts/hooks/destructive-gate.py, BANNED_CMDS), az továbbra is tiltja a sudót.
# És az ágens nem tud jelszót gépelni, ezért a gépen NOPASSWD sudoers-bejegyzés kell
# hozzá (lehetőleg csak a szükséges parancsokra), különben a sudo jelszóra vár és elhasal.
# SUDO_AGENTS=heimdall
# Mely al-ügynök NE töltse be a telepítés gyökerének CLAUDE.md-jét (a fő ügynök
# personája, amit az agents/<név> mappa ősként minden hívásnál behúz). Ágens-nevek
# vesszővel vagy szóközzel; alapból üres = mindenki betölti, mint eddig. A `*` minden
# al-ügynököt jelent, a később létrehozottakat is (a fő ügynököt nem). A listán
# lévő ügynök settings.json-ja claudeMdExcludes: ["<gyökér>/CLAUDE.md"] kulcsot kap,
# a többiéből a kulcs törlődik. Ezzel a gyökér szöveges szabályai is kiesnek, köztük
# ez a három csoport, amely csak a gyökér CLAUDE.md-ben él: a kanban-írás szabálya
# (írás a kártya-eszközön át, soha nyers SQL-lel), a föderációs szabályzat és a levelezési
# szabályok (kötelező CC, aláírás). Indításkor ügynökönként egy naplósor megnevezi ezt
# a hármat. A tény-szabály (tények és találgatás) nincs köztük: minden elindított
# al-ügynök a saját CLAUDE.md-jében generált blokkból kapja meg. Csak az veszti el,
# amely saját generált blokk nélkül fut (pl. a heartbeat worker).
# A hookként futó kapuk (pl. az al-ügynökök settings.json-jában a levélküldő kapu)
# érvényben maradnak, csak a szöveges szabályok esnek ki. Ezért csak olyan ügynökre,
# amelynek saját CLAUDE.md-je tartalmazza, ami kell neki.
# Az ügynök .claude/settings.local.json-jában álló claudeMdExcludes (a gazda kézi
# felülírása) ettől a kulcstól függetlenül érvényes: ez a kulcs azt a fájlt nem írja,
# onnan nem törli, és a listáról levétel sem hozza vissza a gyökér CLAUDE.md-t.
# A SUDO_AGENTS-hez hasonlóan csak ebből a fájlból olvasódik, a fő ügynökre nem hat,
# és a következő respawnnal érvényesül.
# ROOT_CLAUDEMD_EXCLUDE_AGENTS=heimdall
# Mennyi ideig futhat egy elinditott utemezett feladat, mielott az orjarat
# beragadtnak minositi es riaszt (ms). Alapertelmezes: 2700000 (45 perc).
# Feladatonkent a task-config.json `stuckAfterMinutes` kulcsa irja felul.
# Also hatar 60000 (1 perc): ez alatt a riasztas meg az indulasi zajba esne.
# Felso hatar 6 ora: a nyilvantartas ennyi ido utan amugy is eldobja a
# bejegyzest, tehat egy nagyobb ertek nem "kesobbi riasztast" jelentene, hanem
# azt, hogy a riasztas SOHA nem szolal meg. Ezert a kod levagja -- a
# kikapcsolast mondd ki, ne egy nagy szammal erd el.
# Ervenytelen vagy tartomanyon kivuli ertek eseten az alapertelmezes lep eletbe.
# TASK_STALL_TIMEOUT_MS=600000

# Video review tool (dashboard /video-review). Both empty = off.
# VIDEO_REVIEW_ROOT: the folder the videos live in, absolute or relative to the
# project root (e.g. agents/<video-agent>/deliverables). Files are only ever read
# or written under this folder (realpath-checked, symlinks out are refused).
# VIDEO_REVIEW_AGENT: the fleet agent "Küldés" queues the review for.
VIDEO_REVIEW_ROOT=
VIDEO_REVIEW_AGENT=

# Pre-push reviewer-green gate (scripts/git-hooks/pre-push-review-gate.py, docs/security-hardening.md).
# OPT-IN: the hook is installed on every install, but it does nothing until REVIEW_GATE_REVIEWER names
# the reviewer agent. Once set, an agent session's push needs a mailbox line from that agent,
# "<REVIEW_GATE_TRACE_WORD> <8-40 hex digits of the head>". Guards against forgetting, not a bypass.
# REVIEW_GATE_REVIEWER=
# REVIEW_GATE_TRACE_WORD=REVIEW-GREEN

# Meta Graph read helper (scripts/graph-read.py, docs/meta-graph-olvasas.md).
# The shared rate-limit pause file of every caller of the one Meta user token
# (store/.meta-token). Relative = from the project root. Default: store/meta-graph-pause.json.
# META_GRAPH_PAUSE_FILE=store/meta-graph-pause.json

# Where the vault master key lives (src/web/vault.ts). Default (unset): on macOS the login Keychain, with
# store/.vault-key migrated into it on first use. VAULT_KEY_STORE=file keeps the key in store/.vault-key (0600)
# and never calls the Keychain, in every process (dashboard, rotation check, setup, vault scripts), so a locked
# Keychain no longer stops the vault. Read on every key request, no restart needed. After a migration the key
# file is store/.vault-key.migrated: copy it to store/.vault-key (mode 600) BEFORE setting this, or every
# decrypt fails loudly (no new key is ever generated over existing secrets).
# VAULT_KEY_STORE=file

# ============================================================================
# Alfred Core (Multi-Agent Discord & Hybrid Model Router konfiguráció)
# ============================================================================

# Ágens-konfigurációs fájl útvonala (alapértelmezés: config/agents.json)
ALFRED_AGENTS_CONFIG=config/agents.json

# Több-felhasználós Discord jogosultságkezelés (vesszővel elválasztott Discord User Snowflake ID-k).
# Az itt felsorolt felhasználók jogosultak az Alfred ágensek vezérlésére (ágensenként szűkíthető a config/agents.json-ben).
ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Discord Bot Token és az 5 dedikált ágens-csatorna Snowflake ID-ja:
#   #alfred-hq        -> alfred-architect
#   #proj-hypatia     -> alfred-coder-hypatia
#   #alfred-qa        -> alfred-qa
#   #alfred-self-dev  -> alfred-self-coder
#   #alfred-ops       -> alfred-ops
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ALFRED_HQ=1111111111111111111
DISCORD_CHANNEL_PROJ_HYPATIA=2222222222222222222
DISCORD_CHANNEL_ALFRED_QA=3333333333333333333
DISCORD_CHANNEL_ALFRED_SELF_DEV=
DISCORD_CHANNEL_ALFRED_OPS=

# ============================================================================
# Alfred Multi-Environment Izoláció (Production vs. Test/Staging vs. Ops)
# ============================================================================
# ALFRED_ENV: production (alapért.) | test (staging: sárga idle státusz + "🧪 [TEST] " prefix) | ops (DevOps control plane)
ALFRED_ENV=production

# Vesszővel elválasztott aktív ágens ID-k (üres = az összes konfigurált ágens elindul).
# Példa az önálló ultra-könnyű Ops példányhoz: ALFRED_ENABLED_AGENTS=alfred-ops
ALFRED_ENABLED_AGENTS=

# Izolált SQLite adatbázis és munkakönyvtár útvonalak (prod / test / ops soha ne osztozzon ugyanazon a WAL DB-n!):
#   Prod: ALFRED_DB_PATH=store/alfred-prod.db   ALFRED_WORKSPACES_DIR=workspaces       ALFRED_BUDGET_MULTIPLIER=1.0
#   Test: ALFRED_DB_PATH=store/alfred-test.db   ALFRED_WORKSPACES_DIR=workspaces-test  ALFRED_BUDGET_MULTIPLIER=0.2
#   Ops:  ALFRED_DB_PATH=store/alfred-ops.db    ALFRED_ENABLED_AGENTS=alfred-ops       ALFRED_BUDGET_MULTIPLIER=1.0
ALFRED_DB_PATH=store/alfred.db
ALFRED_WORKSPACES_DIR=workspaces
ALFRED_BUDGET_MULTIPLIER=1.0
# ALFRED_TEST_REPLY_PREFIX=🧪 [TEST] 
# DISCORD_STATE_DIR=.claude/channels/discord

# Hibrid Modell-Router 1. szolgáltató: DeepSeek (OpenAI-kompatibilis API, prompt-caching támogatással)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Hibrid Modell-Router 2. szolgáltató: Google Vertex AI EU (GDPR-érzékeny projektekhez, "eu" multi-régió vagy "europe-*"!)
# Az "eu" (aiplatform.eu.rep.googleapis.com) ajánlott a Gemini 3 modellekhez.
VERTEX_EU_PROJECT_ID=your-gcp-eu-project-id
VERTEX_EU_LOCATION=eu
VERTEX_EU_ACCESS_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=store/vertex-eu-sa.json

# CostOps Circuit Breaker: Globális napi költségplafon (USD).
# Ha egy ágens napi limitje (config/agents.json) vagy ez a globális keret eléri a 100%-ot,
# a router blokkolja az API-hívást, és BUDGET_EXCEEDED üzenetet küld a Discord-csatornába.
ALFRED_GLOBAL_DAILY_BUDGET_USD=15.0

# Nem-interaktív CLI szolgáltatók (claude-cli, codex-cli, gemini-cli, agy-cli) párhuzamossági limit:
# Egyszerre legfeljebb ennyi külső CLI folyamat futhat (alapértelmezés: 1; bővített 4+ GB RAM VPS-en növelhető 2 vagy 3 értékre).
ALFRED_CLI_MAX_CONCURRENCY=1
# Egyetlen CLI futás maximális ideje ezredmásodpercben (alapértelmezés: 300000 = 5 perc).
ALFRED_CLI_TIMEOUT_MS=300000
# ALFRED_CLI_MAX_PROMPT_CHARS=32000
# ALFRED_CLAUDE_BIN=claude
# ALFRED_CODEX_BIN=codex
# ALFRED_GEMINI_BIN=gemini
# ALFRED_AGY_BIN=agy

# ============================================================================
# Memória- és SSD-figyelés, automatikus Housekeeping és riasztási küszöbök
# ============================================================================
# Riasztási küszöbértékek (%-ban): ha a RAM vagy az SSD meghaladja a küszöböt,
# az SSD-n automatikus Housekeeping indul (SQLite WAL checkpoint + régi batch/log/tmp törlés + npm cache clean),
# majd strukturált riasztás megy a #alfred-ops Discord-csatornára.
ALFRED_MEM_WARN_PCT=85
ALFRED_DISK_WARN_PCT=80
ALFRED_DISK_CRIT_PCT=90
